# K8s Secrets for tw-stocker
# DO NOT commit this file with real values!
# Apply with: kubectl apply -f secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: tw-stocker-secrets
  namespace: tw-stocker
type: Opaque
stringData:
  DB_PASSWORD: "<from-gcp-secret:db-password>"
  OPENAI_API_KEY: "<from-gcp-secret:openai-api-key>"
  GA_MEASUREMENT_ID: "<from-gcp-secret:ga-measurement-id>"
